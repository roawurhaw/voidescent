# Copy to .env.local and fill in.

# Shows the "redesign preview" bar and tells search engines not to index this
# deployment. Set to "false" only on the real production domain.
NEXT_PUBLIC_PREVIEW=true

# --- Shopify (checkout, policies) -------------------------------------------
# Shopify admin > Settings > Apps and sales channels > Develop apps >
# create an app with Storefront API access, then copy the public access token.
SHOPIFY_STORE_DOMAIN=voidescent.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# Variant IDs (gid://shopify/ProductVariant/...) for each thing we sell.
# Find them in Shopify admin: open the product, click the variant, the number
# at the end of the URL is the ID.
SHOPIFY_VARIANT_NEBULA=
SHOPIFY_VARIANT_HEAVENS=
SHOPIFY_VARIANT_DESCENT=
# Packs: the bundle product's "3 bottles" and "6 bottles" variants.
SHOPIFY_VARIANT_PACK_TRIO=
SHOPIFY_VARIANT_PACK_SIX=

# --- Newsletter ---------------------------------------------------------------
# Any endpoint that accepts POST {"email": "..."} (Klaviyo, Shopify Flow,
# a Zapier/Make hook...). Leave empty to show "not connected yet".
NEWSLETTER_WEBHOOK_URL=
