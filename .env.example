# Copy to .env.local and fill in.

# Keeps this copy out of search engines (noindex + blocking robots.txt). Set to "false" only once
# this site actually replaces the Shopify storefront on voidescent.com.
NEXT_PUBLIC_PREVIEW=true

# The contact form and the newsletter pop-up post their fields as JSON here
# (Zapier/Make webhook, Shopify Flow, Klaviyo, a Discord/Slack hook...). Empty = forms say "not connected".
CONTACT_WEBHOOK_URL=
